# AI Data Analysis Platform — Production Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# NEVER commit real .env files to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# Set to 'production' on Render/Vercel; 'development' for local localhost tests
ENV=production

# ── Groq AI (required for AI-powered insights & Q&A) ─────────────────────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Cost Control & Rate Limits ───────────────────────────────────────────────
# Maximum AI questions allowed per analysis session (prevents API cost runaway)
MAX_QA_PER_SESSION=15

# ── MongoDB Atlas (persistent cloud database) ────────────────────────────────
# From Atlas Dashboard: Database -> Connect -> Drivers -> Python
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=ai_data_analysis

# ── Data Retention & Session Storage ─────────────────────────────────────────
# Lifetime in minutes before analysis sessions & uploaded statements are permanently purged
SESSION_TTL_MINUTES=60

# ── Upload Security ──────────────────────────────────────────────────────────
# Maximum allowed file size for statement uploads (in MB)
MAX_UPLOAD_SIZE_MB=10

# ── CORS & Origin Security ───────────────────────────────────────────────────
# Primary frontend origin (must NOT have a trailing slash)
FRONTEND_ORIGIN=https://smaatech-ai-data-analysis.vercel.app
# Comma-separated list of additional allowed CORS origins (without trailing slashes)
EXTRA_CORS_ORIGINS=http://localhost:5173,https://smaatech-ai-data-analysis.vercel.app

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Authentication & Security Cookies ────────────────────────────────────────
AUTH_REQUIRED=true
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=
# In production with cross-origin frontend (Vercel) and backend (Render):
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_DATA_DIR=app/session/data
AUTH_LOCK_MINUTES=15
AUTH_IDLE_MINUTES=30
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=14

# ── Password Recovery (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Data Analysis Platform
