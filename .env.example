# AI Data Analysis Platform — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# NEVER commit real .env files to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq AI (required for AI-powered insights) ───────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model to use — llama-3.3-70b-versatile is the default
GROQ_MODEL=llama-3.3-70b-versatile

# ── Session ───────────────────────────────────────────────────────────────────
# How long (minutes) to keep analysis results in memory before auto-expiry
SESSION_TTL_MINUTES=60

# ── Upload ────────────────────────────────────────────────────────────────────
# Maximum allowed file size for bank statement uploads (in MB)
MAX_UPLOAD_SIZE_MB=10

# ── CORS / Frontend origin ────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_REQUIRED=true
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_DATA_DIR=app/session/data
AUTH_LOCK_MINUTES=15
AUTH_IDLE_MINUTES=30
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=14

# Local HTTP development: set AUTH_COOKIE_SECURE=false

# ── Password Recovery (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SEPL AI Data Analysis Platform

