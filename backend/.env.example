# AI Data Analysis Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq AI (required for AI-powered insights) ───────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model to use — llama-3.3-70b-versatile is the default (fast & capable)
# Free tier limits: 30 req/min · 1k tokens/min · 100k tokens/day
GROQ_MODEL=llama-3.3-70b-versatile

# ── Session ───────────────────────────────────────────────────────────────────
# How long (minutes) to keep analysis results in memory before auto-expiry
SESSION_TTL_MINUTES=60

# ── Upload ────────────────────────────────────────────────────────────────────
# Maximum allowed file size for bank statement uploads (in MB)
MAX_UPLOAD_SIZE_MB=10

# ── CORS / Frontend origin ────────────────────────────────────────────────────
# Local dev (Vite):     http://localhost:5173
# Local Docker:         http://localhost:8000
# Cloud deployment:     https://your-app.onrender.com  (or your public URL)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: comma-separated list of extra allowed CORS origins
# Useful for staging / preview environments
# EXTRA_CORS_ORIGINS=https://staging.example.com,https://preview.example.com

# ── Server ────────────────────────────────────────────────────────────────────
# Port the container exposes (docker-compose maps this to host port)
# Render / Railway / Fly.io set this automatically — leave blank locally
# PORT=8000

# Authentication (required; set a unique strong bootstrap password in the deployment secret store)
AUTH_REQUIRED=true
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_DATA_DIR=app/session/data
AUTH_LOCK_MINUTES=15
AUTH_IDLE_MINUTES=30
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=14

# Local HTTP development only: AUTH_COOKIE_SECURE=false
# Separate Vercel frontend + Render API may require AUTH_COOKIE_SAMESITE=none (and Secure=true).
# Password recovery requires real SMTP credentials; do not put these in frontend/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SEPL AI Data Analysis Platform
